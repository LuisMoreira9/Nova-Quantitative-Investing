# Local environment template for Nova Quant Club.
#
# Copy this file to ".env" on your own machine, then fill in your Alpaca paper
# trading credentials. The real ".env" file is ignored by git so secrets are
# never committed to the shared repo.
#
# Alpaca paper keys come from Alpaca's Paper Trading dashboard. They identify
# the simulated paper account that receives orders from core/main_executor.py.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Market data feed for stock bars and latest-trade checks.
#
# "iex" is the default because Alpaca's free data plan usually supports it.
# Members with a SIP data subscription can change this to "sip" locally.
ALPACA_DATA_FEED=iex

# Python logging verbosity for the local executor.
#
# INFO is normal. DEBUG can be useful while developing. WARNING is quieter.
LOG_LEVEL=INFO
