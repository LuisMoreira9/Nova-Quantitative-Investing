# Local environment template for Nova Quant Club's IBKR paper executor.
#
# Keep Trader Workstation (TWS) logged into its simulated-trading account and
# enable ActiveX and Socket Clients in TWS API Settings. No brokerage password
# or API secret belongs in this file.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=101
# Read-only dashboard/website polling.  The defaults are 10 and 5 seconds.
NOVA_DASHBOARD_REFRESH_SECONDS=10
NOVA_PORTFOLIO_API_CACHE_SECONDS=5

# Delayed data is normally 15–20 minutes behind the market. Nova polls one
# snapshot per symbol at this interval until real-time subscriptions are added.
IBKR_DELAYED_POLL_SECONDS=60

# European architecture-test trigger. 0.00001 = 0.001% (very permissive).
NOVA_EUROPE_REVERSAL_THRESHOLD=0.00001
NOVA_EUROPE_SCAN_SECONDS=60
# Controlled integration test: buy exactly one unheld approved European name.
NOVA_EUROPE_ARCHITECTURE_TEST_MODE=BUY_ONE

# Nova reports risk and dashboard figures in EUR.
NOVA_BASE_CURRENCY=EUR

# Actual paper FX hedge. This only hedges foreign-currency stock exposure and
# never asks IBKR for a quote; sizing uses Yahoo FX data. Set CONFIRM only
# after reviewing config/fx_hedge_profile.json.
# NOVA_FX_HEDGE_ENABLED=CONFIRM
NOVA_FX_HEDGE_REBALANCE_SECONDS=60

# Optional comma-separated strategy allowlist. The S&P 500 pilot is six liquid
# constituents, each limited to one share and one decision per ten minutes.
# NOVA_ENABLED_STRATEGIES=Sp500AaplMomentumReversal,Sp500MsftMomentumReversal,Sp500NvdaMomentumReversal,Sp500AmznMomentumReversal,Sp500GooglMomentumReversal,Sp500MetaMomentumReversal

# Full S&P 500 yfinance scanner. It screens the universe in Yahoo batches but
# sends only selected candidates to IBKR, capped at 25 orders per cycle.
NOVA_SP500_MAX_POSITIONS=100
NOVA_SP500_MAX_NEW_ORDERS_PER_CYCLE=25
NOVA_SP500_SCAN_SECONDS=60
# 0.00001 = 0.001%; deliberately loose for observing paper-order flow.
NOVA_SP500_REVERSAL_THRESHOLD=0.00001

# Separate, opt-in short/cover paper demonstration. It uses only the six
# listed U.S. symbols, opens at most three one-share short positions, and only
# covers shorts it opened itself. Keep disabled unless deliberately testing.
# NOVA_SHORT_SELLING_PAPER_TEST=CONFIRM
NOVA_SHORT_SELLING_UNIVERSE=AAPL,MSFT,NVDA,AMZN,META,GOOGL
NOVA_SHORT_SELLING_MAX_POSITIONS=3
NOVA_SHORT_SELLING_SCAN_SECONDS=60
NOVA_SHORT_SELLING_REVERSAL_THRESHOLD=0.0001

# Deliberate one-off paper order test. Leave commented/disabled during normal
# operation. It buys then sells one native board lot only after this exact
# confirmation value is supplied.
# NOVA_PAPER_SMOKE_TEST=CONFIRM
# NOVA_PAPER_SMOKE_INSTRUMENT=ASML

# Python logging verbosity for the local executor.
#
# INFO is normal. DEBUG can be useful while developing. WARNING is quieter.
LOG_LEVEL=INFO
# Host-only Supabase publishing credentials. Never commit the secret key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe read key used by a hosted Streamlit dashboard; never use the
# service-role key outside the private IBKR host.
SUPABASE_PUBLISHABLE_KEY=
# Set to supabase when deploying Streamlit to an internet-reachable host.
# NOVA_DASHBOARD_DATA_SOURCE=supabase
# NOVA_SUPABASE_PUBLISH_SECONDS=60
