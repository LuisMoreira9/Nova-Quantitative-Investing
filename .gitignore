# Local secrets and machine-specific environment files.
.env
*.env

# Runtime output, including timestamped launches and recovery attempts.
/data/*.log

# Local diagnostic snapshots and reports (may contain account details).
/data/portfolio_api_check.json
/data/portfolio_sector_audit.json
/data/sector_audit.txt

# Machine-local ownership record for the opt-in held-short paper test.
/data/europe_short_hold_paper_state.json

# Locally accumulated IBKR dashboard history.
data/ibkr_account_history.csv
data/nova_strategy_execution_ledger.csv
data/nova_strategy_pnl_history.csv
data/sp500_pilot_executor.log
data/sp500_pilot_executor_error.log
data/sp500_universe_symbols.txt
data/sp500_yfinance_executor.log
data/sp500_yfinance_executor_error.log
data/sp500_long_paper_state.json
data/sp500_short_paper_state.json
data/sp500_short_yfinance_executor.log
data/sp500_short_yfinance_executor_error.log
data/europe_yfinance_executor.log
data/europe_yfinance_executor_error.log
data/stoxx_europe_600_approved_symbols.txt
data/stoxx_europe_600_contract_validation.csv
data/stoxx_europe_600_membership.csv
data/stoxx_europe_600_contract_discovery.csv
data/stoxx_europe_600_discovery.log
data/stoxx_europe_600_discovery_error.log
data/europe_architecture_test_completed.txt
data/europe_architecture_test_arm.txt
data/fx_hedge_state.json
data/fx_hedge_executor.log
data/fx_hedge_executor_error.log

# Python runtime/cache folders created while running the executor or tests.
__pycache__/
.pytest_cache/

# Local virtual environments. Each member can create their own; none belong in
# the shared repo.
.venv/
venv/

# VaR risk cache/audit/queue (host-local, may contain position-derived weights).
/data/risk.db
/data/risk.db-*
/data/risk_cache*.json

# macOS metadata files that sometimes appear when the repo is opened on a Mac.
.DS_Store
